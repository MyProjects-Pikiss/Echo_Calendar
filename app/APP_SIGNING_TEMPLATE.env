# Echo Calendar Android release signing template
# Copy this file to APP_SIGNING_CONFIG_PATH from config/echo-calendar.config.env,
# then fill in real values outside the git repo.

storeFile=C:\Users\<USER>\Echo_Calendar\release-key.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=echo_calendar_release
keyPassword=CHANGE_ME_KEY_PASSWORD
